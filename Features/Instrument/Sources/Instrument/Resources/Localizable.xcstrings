{
  "sourceLanguage": "en",
  "strings": {
    "quoteDetail.chart.loading": {
      "comment": "Spoken while the chart loads.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chart wird geladen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading chart"
          }
        }
      }
    },
    "quoteDetail.chart.summary %@ %@ %@ %@ %@": {
      "comment": "VoiceOver summary of the chart: company, range, change in percent, the price it compares with and the last price.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, von %4$@ auf %5$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@, from %4$@ to %5$@"
          }
        }
      }
    },
    "quoteDetail.chart.summary.empty %@ %@": {
      "comment": "VoiceOver summary of a chart without prices: company and range.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, noch keine Kurse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, no prices yet"
          }
        }
      }
    },
    "quoteDetail.chart.title %@": {
      "comment": "Audio Graph title of the price chart; the argument is the company name.",
      "localizations": {
