          "stringUnit": {
            "state": "translated",
            "value": "Kurs %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ price"
          }
        }
      }
    },
    "quoteDetail.chart.unavailable": {
