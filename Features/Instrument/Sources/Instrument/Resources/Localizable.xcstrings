          "substitutions": {
            "count": {
              "argNum": 2,
              "formatSpecifier": "lf",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Stück"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Stück"
                    }
                  }
