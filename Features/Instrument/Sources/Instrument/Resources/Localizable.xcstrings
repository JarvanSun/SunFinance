              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You own %1$@ %#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 2,
              "formatSpecifier": "lf",
              "variations": {
